{
  "name": "ComfyMobile",
  "short_name": "ComfyMobile",
  "description": "在 iPad 和平板上编辑并运行家中电脑的 ComfyUI 工作流",
  "start_url": "/comfymobile/",
  "scope": "/comfymobile/",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#10151A",
  "theme_color": "#10151A",
  "icons": [
    { "src": "icon-180.png", "sizes": "180x180", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ]
}
